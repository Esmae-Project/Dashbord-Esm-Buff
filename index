                !Number.isInteger(month) ||
                !Number.isInteger(day)
            ) {
                return value;
            }

            return new Intl.DateTimeFormat(
                "fa-IR-u-ca-persian",
                {
                    year: "numeric",
                    month: "numeric",
                    day: "numeric"
                }
            ).format(
                new Date(
                    Date.UTC(
                        year,
                        month - 1,
                        day,
                        12,
                        0,
                        0
                    )
                )
            );

