    return (

        db.contractors[name]?.work || []

    )

    .filter(
        item =>
            item.status !== "replaced"
    )

    .reduce(

        (sum,item)=>
            sum +
            Number(
                item.amount || 0
            ),

        0

    );

}


function totalPayments(name){

    return (

        db.contractors[name]?.payments || []

    )

    .reduce(

        (sum,item)=>
            sum +
            Number(
                item.amount || 0
            ),

        0

    );

}


function balance(name){


    return (

        totalWork(name)
