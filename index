}


function dateFa(date){

    if(!date)return null;

    try{

        return new Date(
            date + "T00:00:00"
        ).toLocaleDateString("fa-IR");

    }

    catch{

        return date;

    }

}


function esc(text){

    return String(
        text ?? ""
    ).replace(
        /[&<>"']/g,

        c=>({

            "&":"&amp;",
            "<":"&lt;",
            ">":"&gt;",
            '"':"&quot;",
