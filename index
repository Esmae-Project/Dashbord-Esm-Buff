                    project.name
                ]={

                    id:
                        project.id,

                    employer:
                        project.employer ||
                        null,

                    tasks:
                        INITIAL_TASKS[
                            project.name
                        ] || [],

                    completed:[]

                };

            }

        );


        (

            cRes.data || []

        ).forEach(

            contractor=>{

                db.contractors[
                    contractor.name
                ]={

                    id:
                        contractor.id,

                    work:[],

                    payments:[]

                };

            }

        );


        const contractorsById =
            Object.fromEntries(

                (

                    cRes.data || []

                ).map(

                    c=>[
                        c.id,
                        c.name
                    ]

                )

            );


        const projectsById =
            Object.fromEntries(

                (

                    pRes.data || []

                ).map(

                    p=>[
                        p.id,
                        p.name
                    ]

                )

            );


        (

            tRes.data || []

        ).forEach(

            transaction=>{

                const contractor =
                    contractorsById[
                        transaction.contractor_id
                    ];

                const project =
                    projectsById[
                        transaction.project_id
                    ];

                if(
                    !contractor ||
                    !db.contractors[
                        contractor
                    ]
                ){

                    return;

                }


                const item={

                    id:
                        transaction.id,

                    project:
                        project ||
                        "نامشخص",

                    description:
                        transaction.description ||
                        "",

                    amount:
                        Number(
                            transaction.amount_rial ||
                            0
                        ),

                    date:
                        transaction.transaction_date,

                    status:
                        transaction.status

                };


                if(
                    transaction.type ===
                    "work"
                ){

                    db.contractors[
                        contractor
                    ].work.push(item);

                }


                else if(
                    transaction.type ===
                    "payment"
                ){

                    db.contractors[
                        contractor
                    ].payments.push(item);

                }

            }

        );


        showConnectionSuccess(

            "اتصال آنلاین به Supabase موفق است. " +

            `${pRes.data?.length || 0} پروژه، ` +

            `${cRes.data?.length || 0} پیمانکار و ` +

            `${tRes.data?.length || 0} تراکنش دریافت شد.`

        );


        render();


    }

    catch(error){

        console.error(
            "SUPABASE ERROR:",
            error
        );

        showConnectionError(
            "خطا در اتصال به Supabase",
            error
        );

    }

}


