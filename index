<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0a0f1e">
<title>داشبورد یاشار</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
/* =====================================================
   ROOT & RESET
===================================================== */
*{box-sizing:border-box;margin:0;padding:0}

:root {
  --bg-primary: #060b18;
  --bg-secondary: #0d1425;
  --bg-card: rgba(15, 23, 42, 0.7);
  --bg-card-solid: #0f172a;
  --bg-card-hover: rgba(20, 30, 55, 0.85);
  --border-color: rgba(99, 118, 156, 0.15);
  --border-hover: rgba(245, 174, 51, 0.3);
  --text-primary: #f1f5f9;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  --accent-gold: #f5a623;
  --accent-gold-dim: rgba(245, 166, 35, 0.12);
  --accent-blue: #3b82f6;
  --accent-blue-dim: rgba(59, 130, 246, 0.12);
  --accent-green: #22c55e;
  --accent-green-dim: rgba(34, 197, 94, 0.12);
  --accent-red: #ef4444;
  --accent-red-dim: rgba(239, 68, 68, 0.12);
  --accent-purple: #a855f7;
  --accent-purple-dim: rgba(168, 85, 247, 0.12);
  --accent-cyan: #06b6d4;
  --accent-cyan-dim: rgba(6, 182, 212, 0.12);
  --accent-pink: #ec4899;
  --accent-pink-dim: rgba(236, 72, 153, 0.12);
  --accent-amber: #f59e0b;
  --glass-bg: rgba(15, 23, 42, 0.6);
  --glass-border: rgba(99, 118, 156, 0.12);
  --shadow-sm: 0 2px 8px rgba(0,0,0,0.3);
  --shadow-md: 0 8px 32px rgba(0,0,0,0.4);
  --shadow-lg: 0 16px 48px rgba(0,0,0,0.5);
  --shadow-glow: 0 0 40px rgba(245, 166, 35, 0.08);
  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 22px;
  --radius-xl: 28px;
  --font: 'Vazirmatn', -apple-system, BlinkMacSystemFont, 'Segoe UI', Tahoma, sans-serif;
  --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-fast: 0.15s ease;
}

/* =====================================================
   LIGHT THEME
===================================================== */
html.light {
  --bg-primary: #f5f6fa;
  --bg-secondary: #eef0f5;
  --bg-card: rgba(255, 255, 255, 0.9);
  --bg-card-solid: #ffffff;
  --bg-card-hover: rgba(255, 255, 255, 1);
  --border-color: rgba(0, 0, 0, 0.08);
  --border-hover: rgba(245, 166, 35, 0.4);
  --text-primary: #1a1a2e;
  --text-secondary: #4a5568;
  --text-muted: #8896ab;
  --accent-gold: #d4900a;
  --accent-gold-dim: rgba(212, 144, 10, 0.1);
  --accent-blue: #2563eb;
  --accent-blue-dim: rgba(37, 99, 235, 0.1);
  --accent-green: #16a34a;
  --accent-green-dim: rgba(22, 163, 74, 0.1);
  --accent-red: #dc2626;
  --accent-red-dim: rgba(220, 38, 38, 0.1);
  --accent-purple: #9333ea;
  --accent-purple-dim: rgba(147, 51, 234, 0.1);
  --accent-cyan: #0891b2;
  --accent-cyan-dim: rgba(8, 145, 178, 0.1);
  --accent-pink: #db2777;
  --accent-pink-dim: rgba(219, 39, 119, 0.1);
  --accent-amber: #d97706;
  --glass-bg: rgba(255, 255, 255, 0.8);
  --glass-border: rgba(0, 0, 0, 0.06);
  --shadow-sm: 0 2px 8px rgba(0,0,0,0.06);
  --shadow-md: 0 8px 32px rgba(0,0,0,0.08);
  --shadow-lg: 0 16px 48px rgba(0,0,0,0.1);
  --shadow-glow: 0 0 40px rgba(245, 166, 35, 0.06);
}

body {
  background: var(--bg-primary);
  color: var(--text-primary);
  font-family: var(--font);
  font-weight: 400;
  line-height: 1.6;
  overflow-x: hidden;
  min-height: 100vh;
}

body::before {
  content: '';
  position: fixed;
  inset: 0;
  background:
    radial-gradient(ellipse at 20% 0%, rgba(245, 166, 35, 0.04) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 100%, rgba(59, 130, 246, 0.03) 0%, transparent 50%),
    radial-gradient(ellipse at 50% 50%, rgba(168, 85, 247, 0.02) 0%, transparent 60%);
  pointer-events: none;
  z-index: 0;
}

html.light body::before {
  background:
    radial-gradient(ellipse at 20% 0%, rgba(245, 166, 35, 0.06) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 100%, rgba(59, 130, 246, 0.04) 0%, transparent 50%);
}

/* =====================================================
   ANIMATIONS
===================================================== */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 20px rgba(245, 166, 35, 0.1); }
  50% { box-shadow: 0 0 30px rgba(245, 166, 35, 0.2); }
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(40px) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* =====================================================
   APP CONTAINER
===================================================== */
.app {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
  position: relative;
  z-index: 1;
}

/* =====================================================
   HEADER
===================================================== */
header {
  background: linear-gradient(135deg, #0d1425 0%, #1a2542 40%, #0f1d3d 100%);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-xl);
  padding: 28px 32px;
  margin-bottom: 20px;
  position: relative;
  overflow: hidden;
  animation: fadeInUp 0.6s ease;
  box-shadow: var(--shadow-lg), var(--shadow-glow);
  transition: background 0.5s ease, box-shadow 0.5s ease;
}

html.light header {
  background: linear-gradient(135deg, #f8f9fb 0%, #eef0f5 40%, #f0f2f7 100%);
  border-color: rgba(0,0,0,0.06);
  box-shadow: var(--shadow-md);
}

html.light header::after {
  background: linear-gradient(90deg, transparent, rgba(212, 144, 10, 0.4), transparent);
}

html.light h1::first-line {
  background: linear-gradient(135deg, #d4900a, #b8860b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

html.light header .btn {
  background: rgba(0,0,0,0.05);
  border-color: rgba(0,0,0,0.08);
  color: var(--text-secondary);
}

html.light header .btn:hover {
  background: rgba(212, 144, 10, 0.12);
  border-color: rgba(212, 144, 10, 0.3);
  color: var(--accent-gold);
}

header::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at 30% 40%, rgba(245, 166, 35, 0.06) 0%, transparent 40%);
  pointer-events: none;
}

header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(245, 166, 35, 0.3), transparent);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 1;
}

h1 {
  font-size: 24px;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.02em;
  line-height: 1.4;
}

h1::first-line {
  background: linear-gradient(135deg, #f5a623, #fcd34d);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.subtitle {
  color: var(--text-secondary);
  font-size: 13px;
  margin-top: 6px;
  font-weight: 400;
  letter-spacing: 0.02em;
}

/* =====================================================
   HEADER BUTTON (settings)
===================================================== */
header .btn {
  width: 44px;
  height: 44px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.08);
  color: var(--text-secondary);
  backdrop-filter: blur(10px);
  transition: var(--transition);
}

header .btn:hover {
  background: rgba(245, 166, 35, 0.15);
  border-color: rgba(245, 166, 35, 0.3);
  color: var(--accent-gold);
  transform: rotate(30deg);
}

/* =====================================================
   THEME TOGGLE
===================================================== */
.theme-toggle {
  display: flex;
  align-items: center;
  gap: 10px;
}

.theme-toggle-btn {
  width: 52px;
  height: 28px;
  border-radius: 100px;
  border: 1px solid rgba(255,255,255,0.12);
  background: rgba(255,255,255,0.08);
  cursor: pointer;
  position: relative;
  transition: var(--transition);
  padding: 0;
  flex-shrink: 0;
}

.theme-toggle-btn::after {
  content: '';
  position: absolute;
  top: 3px;
  right: 3px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--accent-gold);
  transition: var(--transition);
  box-shadow: 0 2px 6px rgba(0,0,0,0.3);
}

html.light .theme-toggle-btn {
  background: rgba(0,0,0,0.08);
  border-color: rgba(0,0,0,0.12);
}

html.light .theme-toggle-btn::after {
  right: auto;
  left: 3px;
  background: #3b82f6;
  box-shadow: 0 2px 6px rgba(0,0,0,0.15);
}

.theme-toggle-label {
  font-size: 13px;
  color: var(--text-secondary);
  font-weight: 500;
  white-space: nowrap;
}

/* =====================================================
   CONNECTION NOTICE
===================================================== */
.notice {
  background: var(--accent-gold-dim);
  border: 1px solid rgba(245, 166, 35, 0.2);
  color: var(--accent-gold);
  border-radius: var(--radius-md);
  padding: 14px 18px;
  margin-bottom: 16px;
  font-size: 13px;
  line-height: 1.8;
  animation: fadeIn 0.4s ease;
  backdrop-filter: blur(10px);
}

.notice.success-box {
  background: var(--accent-green-dim);
  border-color: rgba(34, 197, 94, 0.2);
  color: var(--accent-green);
}

.notice.error-box {
  background: var(--accent-red-dim);
  border-color: rgba(239, 68, 68, 0.2);
  color: var(--accent-red);
  word-break: break-word;
}

/* =====================================================
   NAVIGATION
===================================================== */
nav {
  display: flex;
  gap: 6px;
  overflow-x: auto;
  padding: 6px 4px 16px;
  margin-bottom: 4px;
  scrollbar-width: none;
  -ms-overflow-style: none;
  animation: fadeIn 0.5s ease 0.1s both;
}

nav::-webkit-scrollbar { display: none; }

nav button {
  white-space: nowrap;
  border: 1px solid var(--border-color);
  background: var(--bg-card);
  color: var(--text-secondary);
  padding: 12px 22px;
  border-radius: 14px;
  cursor: pointer;
  font-family: var(--font);
  font-size: 14px;
  font-weight: 600;
  transition: var(--transition);
  backdrop-filter: blur(10px);
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

nav button::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(245, 166, 35, 0.1), transparent);
  opacity: 0;
  transition: var(--transition);
}

nav button:hover {
  border-color: var(--border-hover);
  color: var(--text-primary);
  transform: translateY(-1px);
}

nav button:hover::before { opacity: 1; }

nav button.active {
  background: linear-gradient(135deg, rgba(245, 166, 35, 0.15), rgba(245, 166, 35, 0.08));
  color: var(--accent-gold);
  border-color: rgba(245, 166, 35, 0.3);
  font-weight: 700;
  box-shadow: 0 0 20px rgba(245, 166, 35, 0.08);
  letter-spacing: 0.01em;
}

nav button.active::before { opacity: 1; }

/* =====================================================
   VIEWS
===================================================== */
.view {
  display: none;
  animation: fadeInUp 0.4s ease;
}

.view.active { display: block; }

/* =====================================================
   SECTION
===================================================== */
.section {
  margin-top: 24px;
}

.section h2 {
  font-size: 17px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
}

/* =====================================================
   GRIDS
===================================================== */
.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  animation: fadeInUp 0.5s ease 0.15s both;
}

.cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

/* =====================================================
   CARDS
===================================================== */
.card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 20px;
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(20px);
  transition: var(--transition);
  position: relative;
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.06), transparent);
}

.card:hover {
  border-color: var(--border-hover);
  box-shadow: var(--shadow-md), 0 0 30px rgba(245, 166, 35, 0.04);
  transform: translateY(-2px);
}

/* =====================================================
   STAT CARDS
===================================================== */
.card.stat {
  text-align: center;
  padding: 22px 16px;
  position: relative;
}

.card.stat::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 10%;
  right: 10%;
  height: 2px;
  border-radius: 2px;
  background: linear-gradient(90deg, transparent, var(--accent-gold), transparent);
  opacity: 0;
  transition: var(--transition);
}

.card.stat:hover::after { opacity: 1; }

.card.stat small {
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.card.stat strong {
  display: block;
  font-size: 22px;
  font-weight: 800;
  margin-top: 10px;
  color: var(--text-primary);
  letter-spacing: -0.02em;
}

/* =====================================================
   ROW
===================================================== */
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

/* =====================================================
   TYPOGRAPHY HELPERS
===================================================== */
.muted {
  color: var(--text-muted);
  font-size: 13px;
  line-height: 1.7;
}

.danger { color: var(--accent-red); }
.success { color: var(--accent-green); }

/* =====================================================
   PILLS
===================================================== */
.pill {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.06);
  padding: 5px 12px;
  border-radius: 100px;
  font-size: 11px;
  font-weight: 500;
  color: var(--text-secondary);
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

/* =====================================================
   TASKS
===================================================== */
.task {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid rgba(255,255,255,0.04);
  transition: var(--transition-fast);
}

.task:last-child { border-bottom: 0; }

.task:hover {
  background: rgba(255,255,255,0.02);
  margin: 0 -12px;
  padding: 12px;
  border-radius: 12px;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex: none;
  position: relative;
}

.dot::after {
  content: '';
  position: absolute;
  inset: -3px;
  border-radius: 50%;
  background: inherit;
  opacity: 0.2;
}

.red { background: var(--accent-red); }
.yellow { background: var(--accent-amber); }
.green-dot { background: var(--accent-green); }

/* =====================================================
   TOOLBAR
===================================================== */
.toolbar {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 16px;
}

/* =====================================================
   BUTTONS
===================================================== */
.btn {
  border: 0;
  background: linear-gradient(135deg, var(--accent-gold), #e09400);
  color: #0a0f1e;
  padding: 11px 20px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-family: var(--font);
  font-size: 13px;
  font-weight: 600;
  transition: var(--transition);
  box-shadow: 0 4px 12px rgba(245, 166, 35, 0.2);
  position: relative;
  overflow: hidden;
}

.btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.2), transparent);
  opacity: 0;
  transition: var(--transition);
}

.btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(245, 166, 35, 0.3);
}

.btn:hover::before { opacity: 1; }

.btn:active { transform: translateY(0); }

.btn.green {
  background: linear-gradient(135deg, var(--accent-green), #16a34a);
  box-shadow: 0 4px 12px rgba(34, 197, 94, 0.2);
}

.btn.green:hover {
  box-shadow: 0 6px 20px rgba(34, 197, 94, 0.3);
}

.btn.red {
  background: linear-gradient(135deg, var(--accent-red), #dc2626);
  box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);
}

.btn.red:hover {
  box-shadow: 0 6px 20px rgba(239, 68, 68, 0.3);
}

.btn.light {
  background: rgba(255,255,255,0.06);
  color: var(--text-primary);
  border: 1px solid var(--border-color);
  box-shadow: none;
}

.btn.light:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.15);
  box-shadow: none;
}

/* =====================================================
   TABLE
===================================================== */
.table-wrap {
  overflow: auto;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  backdrop-filter: blur(20px);
}

table {
  width: 100%;
  border-collapse: collapse;
}

th, td {
  padding: 14px 16px;
  text-align: right;
  border-bottom: 1px solid rgba(255,255,255,0.04);
  font-size: 13px;
}

th {
  background: rgba(255,255,255,0.03);
  color: var(--text-muted);
  font-weight: 600;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  position: sticky;
  top: 0;
}

tr {
  transition: var(--transition-fast);
}

tbody tr:hover {
  background: rgba(255,255,255,0.02);
}

tbody tr:last-child td {
  border-bottom: 0;
}

/* =====================================================
   ACCORDION
===================================================== */
.accounting-accordion {
  margin-top: 12px;
  padding: 0;
  overflow: hidden;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(20px);
  transition: var(--transition);
}

.accounting-accordion:hover {
  border-color: var(--border-hover);
}

.accounting-accordion summary {
  list-style: none;
  padding: 18px 20px;
  cursor: pointer;
  font-size: 15px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: space-between;
  user-select: none;
  transition: var(--transition);
  color: var(--text-primary);
}

.accounting-accordion summary::-webkit-details-marker { display: none; }

.accounting-accordion summary::after {
  content: "＋";
  font-size: 20px;
  color: var(--text-muted);
  font-weight: 400;
  transition: var(--transition);
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: rgba(255,255,255,0.04);
}

.accounting-accordion[open] summary::after {
  content: "−";
  background: var(--accent-gold-dim);
  color: var(--accent-gold);
}

.accounting-accordion[open] summary {
  border-bottom: 1px solid var(--border-color);
}

.accounting-accordion summary:hover {
  background: rgba(255,255,255,0.02);
}

.accordion-content {
  padding: 18px;
  animation: slideDown 0.3s ease;
}

.accounting-accordion + .accounting-accordion {
  margin-top: 10px;
}

/* =====================================================
   MODAL
===================================================== */
.modal {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(8px);
  z-index: 100;
  align-items: flex-end;
  justify-content: center;
  padding: 16px;
}

.modal.show {
  display: flex;
  animation: fadeIn 0.2s ease;
}

.modal-box {
  background: var(--bg-card-solid);
  border: 1px solid var(--border-color);
  width: min(650px, 100%);
  max-height: 90vh;
  overflow: auto;
  border-radius: var(--radius-xl) var(--radius-xl) var(--radius-lg) var(--radius-lg);
  padding: 28px;
  animation: slideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: var(--shadow-lg);
}

.modal-box h3 {
  font-size: 18px;
  font-weight: 800;
  margin-bottom: 16px;
  color: var(--text-primary);
}

