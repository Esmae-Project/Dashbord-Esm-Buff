async function loadInventory() {
  const box = document.getElementById("inventoryList");
  if (!box) {
    console.error("inventoryList پیدا نشد");
    return;
  }
  box.innerHTML = `
    <div class="empty">
      ⏳ در حال دریافت موجودی انبار...
    </div>
  `;
  try {
    if (!sb) {
      throw new Error("اتصال به Supabase برقرار نیست.");
    }
    const { data: inventoryData, error: inventoryError } =
      await sb
        .from("inventory_items")
        .select(`
          id,
          project_id,
          item_name,
          unit,
          current_quantity,
          created_at,
          updated_at
        `)
        .order("item_name", {
          ascending: true
        });
    if (inventoryError) {
      throw inventoryError;
    }
    const NON_INVENTORY_WORDS = [
      "کرایه",
      "حمل",
      "باربری",
      "بارگیری",
      "تخلیه",
      "ناهار",
      "غذا",
      "صبحانه",
      "شام",
      "پذیرایی",
      "تعمیر",
      "سرویس",
      "خدمات",
      "دستمزد",
      "اجرت",
      "هزینه"
    ];
    function isRealInventoryItem(item) {
      const name =
        String(
          item?.item_name || ""
        ).trim().toLowerCase();
      if (!name) {
        return false;
      }
      return !NON_INVENTORY_WORDS.some(
        word => name.includes(word)
      );
    }
    const inventoryItems =
      (inventoryData || []).filter(
        isRealInventoryItem
      );
    const { data: projectsData, error: projectsError } =
      await sb
        .from("projects")
        .select(`
          id,
          name
        `)
        .order("name", {
          ascending: true
        });
    if (projectsError) {
      throw projectsError;
    }
    const projectsById =
      Object.fromEntries(
        (projectsData || []).map(
          project => [
            project.id,
            project.name
          ]
        )
      );
    const { data: movementsData, error: movementsError } =
      await sb
        .from("inventory_movements")
        .select(`
          id,
          item_id,
          movement_type,
          quantity,
          unit,
          movement_date,
          description,
          created_at
        `)
        .order("movement_date", {
          ascending: false
        });
    if (movementsError) {
      throw movementsError;
    }
    const inventoryById =
      Object.fromEntries(
        inventoryItems.map(
          item => [
            item.id,
            item
          ]
        )
      );
    const consumedByItem = {};
    (movementsData || []).forEach(
      movement => {
        if (
          movement.movement_type !== "out"
        ) {
          return;
        }
        const quantity =
          Number(
            movement.quantity || 0
          );
        consumedByItem[movement.item_id] =
          (
            consumedByItem[movement.item_id] || 0
          ) + quantity;
      }
    );
    const grouped = {};
    (movementsData || [])
      .filter(
        movement =>
          movement.movement_type === "in"
      )
      .forEach(
        movement => {
          const item =
            inventoryById[
              movement.item_id
            ];
          if (!item) {
            return;
          }
          const projectName =
            projectsById[
              item.project_id
            ] ||
            "پروژه نامشخص";
          if (!grouped[projectName]) {
            grouped[projectName] = {};
          }
          const dateKey =
            movement.movement_date
              ? String(
                  movement.movement_date
                ).slice(0, 10)
              : "بدون تاریخ";
          if (!grouped[projectName][dateKey]) {
            grouped[projectName][dateKey] = [];
          }
          grouped[projectName][dateKey].push({
            item,
            quantity:
              Number(
                movement.quantity || 0
              ),
            unit:
              movement.unit ||
              item.unit ||
              "عدد",
            description:
              movement.description || ""
          });
        }
      );
    if (
      Object.keys(grouped).length === 0
    ) {
      box.innerHTML = `
        <div class="empty">
          📦 هنوز ورود واقعی به انبار ثبت نشده.
        </div>
      `;
      return;
    }
    function formatInventoryDate(dateString) {
      if (!dateString) {
        return "بدون تاریخ";
      }
      const date =
        new Date(
          `${dateString}T12:00:00`
        );
      if (
        Number.isNaN(
          date.getTime()
        )
      ) {
        return esc(dateString);
      }
      return new Intl.DateTimeFormat(
        "fa-IR-u-ca-persian",
        {
          year: "numeric",
          month: "long",
          day: "numeric"
        }
      ).format(date);
    }
    function getConsumptionText(item) {
      const consumed =
        Number(
          consumedByItem[item.id] || 0
        );
      const current =
        Number(
          item.current_quantity || 0
        );
      if (consumed <= 0) {
        return `
          <div
            class="muted"
            style="
              margin-top:6px;
              font-size:12px;
            "
          >
            (مصرف نشده)
          </div>
        `;
      }
      if (current <= 0) {
        return `
          <div
            class="muted"
            style="
              margin-top:6px;
              font-size:12px;
            "
          >
            (کل موجودی مصرف شده)
          </div>
        `;
      }
      return `
        <div
          class="muted"
          style="
            margin-top:6px;
            font-size:12px;
          "
        >
          (
          ${consumed.toLocaleString("fa-IR")}
          ${esc(item.unit || "عدد")}
          مصرف شده
          )
        </div>
      `;
    }
    const projectEntries =
      Object.entries(grouped)
        .sort(
          ([a], [b]) =>
            a.localeCompare(
              b,
              "fa"
            )
        );
    box.innerHTML =
      projectEntries
        .map(
          ([projectName, dates]) => {
            const dateEntries =
              Object.entries(dates)
                .sort(
                  ([a], [b]) =>
                    b.localeCompare(a)
                );
            return `
              <details class="accounting-accordion">
                <summary>
                  <span>
                    🏗️ ${esc(projectName)}
                  </span>
                  <span class="pill">
                    ${dateEntries.length.toLocaleString("fa-IR")}
                    روز
                  </span>
                </summary>
                <div class="accordion-content">
                  ${
                    dateEntries
                      .map(
                        ([dateKey, movements]) => {
                          return `
                            <details
                              class="accounting-accordion"
                              style="
                                margin:10px 0;
                                border:1px solid var(--border-color);
                              "
                            >
                              <summary>
                                <span>
                                  📅
                                  ${formatInventoryDate(
                                    dateKey
                                  )}
                                </span>
                                <span class="pill">
                                  ${movements.length.toLocaleString("fa-IR")}
                                  قلم
                                </span>
                              </summary>
                              <div class="accordion-content">
                                ${
                                  movements
                                    .map(
                                      movement => {
                                        const quantity =
                                          Number(
                                            movement.quantity || 0
                                          );
                                        const quantityClass =
                                          quantity > 0
                                            ? "success"
                                            : "danger";
                                        return `
                                          <div
                                            style="
                                              background:rgba(255,255,255,0.03);
                                              border:1px solid var(--border-color);
                                              border-radius:14px;
                                              padding:16px;
                                              margin-bottom:10px;
                                            "
                                          >
                                            <div
                                              style="
                                                display:flex;
                                                justify-content:space-between;
                                                align-items:center;
                                                gap:10px;
                                              "
                                            >
                                              <strong>

                                                📦
                                                ${esc(
                                                  movement.item.item_name
                                                )}
                                              </strong>
                                              <strong
                                                class="${quantityClass}"
                                              >
                                                +
                                                ${quantity.toLocaleString("fa-IR")}
                                                ${esc(
                                                  movement.unit
                                                )}
                                              </strong>
                                            </div>
                                            <div
                                              style="
                                                margin-top:8px;
                                                font-size:13px;
                                              "
                                            >
                                              موجودی فعلی:
                                              <strong>
                                                ${Number(
                                                  movement.item.current_quantity || 0
                                                ).toLocaleString("fa-IR")}
                                                ${esc(
                                                  movement.item.unit || movement.unit
                                                )}
                                              </strong>
                                            </div>
                                            ${getConsumptionText(
                                              movement.item
                                            )}
                                            ${
                                              movement.description
                                                ? `
                                                  <div
                                                    class="muted"
                                                    style="margin-top:8px"
                                                  >
                                                    ${esc(
                                                      movement.description
                                                    )}
                                                  </div>
                                                `
                                                : ""
                                            }
                                          </div>
                                        `;
                                      }
                                    )
                                    .join("")
                                }
                              </div>
                            </details>
                          `;
                        }
                      )
                      .join("")
                  }
                </div>
              </details>
            `;
          }
        )
        .join("");
  }
  catch (error) {
    console.error(
      "INVENTORY ERROR:",
      error
    );
    box.innerHTML = `
      <div class="notice error-box">
        ❌ خطا در دریافت موجودی انبار
        <br><br>
        <small>
          ${esc(
            error?.message ||
            String(error)
          )}
        </small>
      </div>
    `;
  }
}


async function loadPersonalAccounts() {

  const table =
    document.getElementById("personalAccountsTable");

  const summary =
    document.getElementById("personalAccountsSummary");

  if (!table) {
    console.error(
      "personalAccountsTable پیدا نشد"
    );
    return;
  }

  table.innerHTML = `
    <tr>
      <td colspan="6" style="text-align:center">
        ⏳ در حال دریافت حساب‌های شخصی...
      </td>
    </tr>
  `;

  try {

    const { data, error } = await sb
      .from("personal_accounts")
      .select("*")
      .order("account_date", {
        ascending: false
      });

    if (error) {
      console.error(
        "Supabase personal_accounts error:",
        error
      );

      throw error;
    }

    console.log(
      "Personal accounts:",
      data
    );

    if (!data || data.length === 0) {

      table.innerHTML = `
        <tr>
          <td
            colspan="6"
            style="text-align:center"
          >
            👤 هنوز حساب شخصی ثبت نشده.
          </td>
        </tr>
      `;

      if (summary) {
        summary.innerHTML = "";
      }

      return;

    }

    let totalDebt = 0;
    let totalCredit = 0;

    const formatMoney = value => {

      return (
        Number(value || 0)
          .toLocaleString("fa-IR")
        + " ریال"
      );

    };

    const formatDate = value => {

      if (!value) {
        return "-";
      }

      const date = new Date(value);

      if (isNaN(date.getTime())) {
        return String(value);
      }

      return date.toLocaleDateString(
        "fa-IR"
      );

    };

    data.forEach(item => {

      const amount =
        Number(item.amount_rial || 0);

      const paid =
        Number(item.paid_rial || 0);

      const remaining =
        Math.max(
          amount - paid,
          0
        );

      const type =
        String(
          item.account_type || ""
        ).toLowerCase();

      const isSalary =
        type === "salary" ||
        type.includes("salary") ||
        type.includes("حقوق");

      const isDebt =
        type === "debt" ||
        type.includes("debt") ||
        type.includes("owe");

      if (isSalary) {

        return;

      }

      if (isDebt) {

        totalDebt += remaining;

      } else {

        totalCredit += remaining;

      }

    });

    if (summary) {

      summary.innerHTML = `

        <div class="card">

          <div class="muted">
            💸 مجموع بدهی من
          </div>

          <div
            style="
              font-size:20px;
              font-weight:800;
              margin-top:6px;
            "
          >
            ${formatMoney(totalDebt)}
          </div>

        </div>


        <div class="card">

          <div class="muted">
            💰 مجموع طلب من
          </div>

          <div
            style="
              font-size:20px;
              font-weight:800;
              margin-top:6px;
            "
          >
            ${formatMoney(totalCredit)}
          </div>

        </div>

      `;

    }

    table.innerHTML = data.map(item => {

      const amount =
        Number(item.amount_rial || 0);

      const paid =
        Number(item.paid_rial || 0);

      const remaining =
        Math.max(
          amount - paid,
          0
        );

      const type =
        String(
          item.account_type || ""
        ).toLowerCase();

      const isSalary =
        type === "salary" ||
        type.includes("salary") ||
        type.includes("حقوق");

      const isDebt =
        type === "debt" ||
        type.includes("debt") ||
        type.includes("owe");

      const personName =
        item.person_name ||
        "بدون نام";

      let accountLabel = "💰 طلبکارم";
      let amountClass = "success";

      if (isSalary) {

        accountLabel = "💵 حقوق دریافتی";
        amountClass = "success";

      } else if (isDebt) {

        accountLabel = "💸 بدهکارم";
        amountClass = "danger";

      }

      return `

        <tr>

          <td>

            <b>
              👤 ${personName}
            </b>

          </td>

          <td>

            <span class="pill">

              ${accountLabel}

            </span>

          </td>

          <td>

            ${formatMoney(amount)}

          </td>

          <td>

            ${formatMoney(paid)}

          </td>

          <td>

            <b
              class="${amountClass}"
            >

              ${formatMoney(remaining)}

            </b>

          </td>

          <td>

            ${formatDate(
              item.account_date
            )}

          </td>

        </tr>

      `;

    }).join("");

  } catch (error) {

    console.error(
      "PERSONAL ACCOUNTS ERROR:",
      error
    );

    table.innerHTML = `

      <tr>

        <td
          colspan="6"
          style="
            text-align:center;
            color:var(--accent-red);
            padding:20px;
          "
        >

          ❌ خطا در دریافت حساب‌های شخصی

          <br><br>

          <small>

            ${
              error?.message ||
              String(error)
            }

          </small>

        </td>

      </tr>

    `;

  }

}



